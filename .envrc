# Load the devenv shell (devenv.nix) on `cd`. Run `direnv allow` once to
# enable it. devenv caches the shell, so entry is fast after the first build.
export DIRENV_WARN_TIMEOUT=20s
eval "$(devenv direnvrc)"
use devenv

# Local overrides: provider keys and the like. Never commit this file.
dotenv_if_exists .env
