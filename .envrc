# Load the flake dev shell on `cd`. Run `direnv allow` once to enable it.
#
# With nix-direnv installed, `use flake` caches the shell, so entry is fast
# after the first build. Plain direnv works too, only slower.
use flake

# Keep Go's caches inside the repository so a `nix develop` and a direnv
# shell agree, and so `git clean -xdf` really cleans.
export GOPATH="$PWD/.direnv/go"
export GOBIN="$GOPATH/bin"
PATH_add "$GOBIN"

# Local overrides: provider keys and the like. Never commit this file.
dotenv_if_exists .env
